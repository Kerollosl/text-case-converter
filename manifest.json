{
  "manifest_version": 3,
  "name": "Text Case Converter",
  "version": "1.2",
  "description": "Right-click or use shortcuts to convert selected text case",
  "permissions": ["contextMenus"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "commands": {
    "upper": {
      "suggested_key": { "default": "Alt+Shift+U" },
      "description": "Convert selected text to uppercase"
    },
    "lower": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Convert selected text to lowercase"
    },
    "title": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "Convert selected text to title case"
    },
    "sentence": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Convert selected text to sentence case"
    }
  }
}
