{
  "manifest_version": 3,
  "name": "Text Case Converter",
  "version": "1.3.0",
  "description": "Convert selected text to UPPER, lower, Title, Sentence, camelCase, snake_case or kebab-case from the right-click menu or a shortcut.",
  "minimum_chrome_version": "111",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Text Case Converter: shortcuts and help",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "commands": {
    "upper": {
      "suggested_key": {
        "default": "Alt+Shift+U",
        "mac": "MacCtrl+Shift+U"
      },
      "description": "Convert selected text to uppercase"
    },
    "lower": {
      "suggested_key": {
        "default": "Alt+Shift+L",
        "mac": "MacCtrl+Shift+L"
      },
      "description": "Convert selected text to lowercase"
    },
    "title": {
      "suggested_key": {
        "default": "Alt+Shift+T",
        "mac": "MacCtrl+Shift+T"
      },
      "description": "Convert selected text to title case"
    },
    "sentence": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "MacCtrl+Shift+S"
      },
      "description": "Convert selected text to sentence case"
    }
  }
}
